# ==============================
# Secrets and local configuration
# ==============================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ==============================
# Maven / Java build output
# ==============================
target/
build/
out/
*.class
*.jar
*.war
*.ear

# Keep Maven wrapper files if you add them later
!.mvn/wrapper/maven-wrapper.jar

# ==============================
# Logs and temporary files
# ==============================
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# ==============================
# IDE and editor settings
# ==============================
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# ==============================
# Operating system files
# ==============================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================
# Local database exports and backups
# ==============================
*.sql.bak
*.dump
*.sqlite
*.sqlite3

# ==============================
# Environment-specific files
# ==============================
.env.local
.env.development.local
.env.test.local
.env.production.local
# Java crash dumps and profiling output
hs_err_pid*
replay_pid*
*.hprof

# NetBeans private/local state
.nb-gradle/
.nbproject/private/

# Local embedded database artifacts
*.mv.db
*.trace.db
