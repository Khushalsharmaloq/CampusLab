<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">ACCESS MANAGEMENT</p><h1>Users</h1><p class="muted">Create student and administrator accounts for the CampusLab workspace.</p></div></section>
<section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">ADMINISTRATION</p><h2>Create a user</h2></div></div><form method="post" action="${pageContext.request.contextPath}/app/users" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="createUser"><label>Full name<input name="name" required maxlength="120"></label><label>Email address<input type="email" name="email" required maxlength="190"></label><label>Temporary password<input type="password" name="password" required minlength="8" autocomplete="new-password"></label><label>Role<select name="role"><option value="STUDENT">STUDENT</option><option value="ADMIN">ADMIN</option></select></label><div class="form-actions"><button class="button button-primary" type="submit">Create user</button></div></form></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">REGISTERED ACCOUNTS</p><h2>Users</h2></div><span class="count-pill"><c:out value="${users.size()}"/> accounts</span></div><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Created</th></tr></thead><tbody><c:forEach items="${users}" var="u"><tr><td><strong><c:out value="${u.full_name}"/></strong></td><td><c:out value="${u.email}"/></td><td><span class="role-pill"><c:out value="${u.role}"/></span></td><td><c:out value="${u.created_at}"/></td></tr></c:forEach></tbody></table></div></section>
<%@ include file="footer.jspf" %>
