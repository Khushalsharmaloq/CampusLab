<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">PRACTICAL WORK</p><h1>Lab exercises</h1><p class="muted">Review instructions and submit your work as a repository or project URL.</p></div></section>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">ADMINISTRATION</p><h2>Create a lab exercise</h2></div></div><form method="post" action="${pageContext.request.contextPath}/app/labs" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="createLab"><label>Course<select name="courseId"><option value="">No course linked</option><c:forEach items="${courses}" var="course"><option value="${course.id}"><c:out value="${course.code}"/> — <c:out value="${course.name}"/></option></c:forEach></select></label><label>Lab title<input name="title" maxlength="180" required placeholder="JDBC CRUD Application"></label><label>Due date (optional)<input type="date" name="dueDate"></label><label class="span-two">Description<textarea name="description" rows="3" placeholder="Lab requirements and acceptance criteria"></textarea></label><div class="form-actions"><button class="button button-primary" type="submit">Create lab</button></div></form></section></c:if>
<section class="lab-grid"><c:forEach items="${labs}" var="lab"><article class="panel lab-card"><div class="lab-card-top"><span class="code-tag"><c:out value="${empty lab.course_code ? 'GENERAL' : lab.course_code}"/></span><span class="status status-open"><c:out value="${lab.status}"/></span></div><h2><c:out value="${lab.title}"/></h2><p class="muted"><c:out value="${lab.description}"/></p><div class="lab-meta"><span><small>COURSE</small><strong><c:out value="${empty lab.course_name ? 'Unassigned' : lab.course_name}"/></strong></span><span><small>DUE DATE</small><strong><c:out value="${empty lab.due_date ? 'Not set' : lab.due_date}"/></strong></span></div>
<c:if test="${sessionScope.user.role eq 'STUDENT'}"><form method="post" action="${pageContext.request.contextPath}/app/labs" class="submission-mini"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="submitLab"><input type="hidden" name="labId" value="${lab.id}"><label>GitHub / submission URL<input name="submissionUrl" type="url" required placeholder="https://github.com/you/project"></label><label>Remarks <textarea name="remarks" rows="2" placeholder="Optional notes"></textarea></label><button class="button button-primary button-wide" type="submit">Submit work</button></form></c:if>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><form method="post" action="${pageContext.request.contextPath}/app/labs" class="card-action"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="deleteLab"><input type="hidden" name="id" value="${lab.id}"><button class="button button-danger button-small" type="submit" data-confirm="Delete this lab and its submissions?">Delete lab</button></form></c:if></article></c:forEach><c:if test="${empty labs}"><div class="panel empty-state">No lab exercises yet.</div></c:if></section>
<%@ include file="footer.jspf" %>
