<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">BUILD & TRACK</p><h1>Projects</h1><p class="muted">Track student projects, technologies and progress.</p></div></section>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">ADMINISTRATION</p><h2>Create a project</h2></div></div><form method="post" action="${pageContext.request.contextPath}/app/projects" class="form-grid"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="createProject"><label>Project title<input name="title" required maxlength="180" placeholder="CampusLab"></label><label>Technology stack<input name="techStack" maxlength="240" placeholder="Java, Swing, JSP, Servlets, MySQL"></label><label>Owner (student)<select name="ownerId"><option value="">Unassigned</option><c:forEach items="${users}" var="u"><c:if test="${u.role eq 'STUDENT'}"><option value="${u.id}"><c:out value="${u.full_name}"/> — <c:out value="${u.email}"/></option></c:if></c:forEach></select></label><label class="span-two">Description<textarea name="description" rows="3" placeholder="Project goal and key functionality"></textarea></label><div class="form-actions"><button class="button button-primary" type="submit">Create project</button></div></form></section></c:if>
<section class="project-grid"><c:forEach items="${projects}" var="project"><article class="panel project-card"><div class="project-top"><span class="project-mark">◇</span><span class="status"><c:out value="${project.status}"/></span></div><h2><c:out value="${project.title}"/></h2><p class="muted"><c:out value="${project.description}"/></p><div class="tech-stack"><c:out value="${project.tech_stack}"/></div><div class="project-footer"><span><small>OWNER</small><strong><c:out value="${empty project.owner_name ? 'Unassigned' : project.owner_name}"/></strong></span><span><small>CREATED</small><strong><c:out value="${project.created_at}"/></strong></span></div>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><div class="project-actions"><form method="post" action="${pageContext.request.contextPath}/app/projects"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="updateProjectStatus"><input type="hidden" name="id" value="${project.id}"><select name="status"><option value="PLANNED" ${project.status eq 'PLANNED' ? 'selected' : ''}>PLANNED</option><option value="IN_PROGRESS" ${project.status eq 'IN_PROGRESS' ? 'selected' : ''}>IN_PROGRESS</option><option value="COMPLETED" ${project.status eq 'COMPLETED' ? 'selected' : ''}>COMPLETED</option><option value="ON_HOLD" ${project.status eq 'ON_HOLD' ? 'selected' : ''}>ON_HOLD</option></select><button class="button button-secondary button-small" type="submit">Update</button></form><form method="post" action="${pageContext.request.contextPath}/app/projects" data-confirm="Delete this project?"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="deleteProject"><input type="hidden" name="id" value="${project.id}"><button class="button button-danger button-small" type="submit">Delete</button></form></div></c:if></article></c:forEach><c:if test="${empty projects}"><div class="panel empty-state">No projects have been created yet.</div></c:if></section>
<%@ include file="footer.jspf" %>
