<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">YOUR WORKSPACE</p><h1>Overview</h1><p class="muted">A clear view of courses, lab exercises, projects and work submitted.</p></div><span class="role-pill"><c:out value="${sessionScope.user.role}"/></span></section>
<section class="stat-grid"><article class="stat-card"><span class="stat-icon">▤</span><p>Courses</p><strong><c:out value="${summary.courses}"/></strong><a href="${pageContext.request.contextPath}/app/courses">View courses →</a></article><article class="stat-card"><span class="stat-icon">⌘</span><p>Lab exercises</p><strong><c:out value="${summary.labs}"/></strong><a href="${pageContext.request.contextPath}/app/labs">View labs →</a></article><article class="stat-card"><span class="stat-icon">◇</span><p>Projects</p><strong><c:out value="${summary.projects}"/></strong><a href="${pageContext.request.contextPath}/app/projects">View projects →</a></article><article class="stat-card"><span class="stat-icon">↗</span><p>Submissions</p><strong><c:out value="${summary.submissions}"/></strong><a href="${pageContext.request.contextPath}/app/submissions">View submissions →</a></article></section>
<section class="content-grid"><article class="panel"><div class="panel-heading"><div><p class="eyebrow">GET STARTED</p><h2>Project workspace</h2></div></div><p class="muted">Manage the practical work for your semester in one place. Course, lab, project and submission records are stored in MySQL and shared between the desktop and web applications.</p><div class="quick-links"><a href="${pageContext.request.contextPath}/app/courses"><span>01</span><div><strong>Browse courses</strong><small>See course codes and lab counts</small></div><b>→</b></a><a href="${pageContext.request.contextPath}/app/labs"><span>02</span><div><strong>Open lab exercises</strong><small>Review requirements and submit work</small></div><b>→</b></a><a href="${pageContext.request.contextPath}/app/projects"><span>03</span><div><strong>Track projects</strong><small>Review technology stacks and status</small></div><b>→</b></a></div></article><article class="panel"><p class="eyebrow">SUBMISSION QUEUE</p><h2><c:out value="${summary.pending}"/> pending</h2><p class="muted"><c:choose><c:when test="${sessionScope.user.role eq 'ADMIN'}">Items waiting for faculty review.</c:when><c:otherwise>Your submissions not yet reviewed.</c:otherwise></c:choose></p><a class="button button-primary" href="${pageContext.request.contextPath}/app/submissions">Open submissions →</a><c:if test="${sessionScope.user.role eq 'ADMIN'}"><div class="notice">Administrator access is enabled. You can create courses, labs and projects, manage accounts, and review submissions.</div></c:if><c:if test="${sessionScope.user.role eq 'STUDENT'}"><div class="notice">Student access is enabled. You can browse academic work and submit a repository or project URL.</div></c:if></article></section>
