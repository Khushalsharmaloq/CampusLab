<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">TURN IN & REVIEW</p><h1>Submissions</h1><p class="muted">Students submit links; administrators record a review status and feedback.</p></div></section>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">SUBMISSION REGISTER</p><h2>Lab work</h2></div><span class="count-pill"><c:out value="${submissions.size()}"/> records</span></div><div class="table-wrap"><table><thead><tr><th>Lab</th><c:if test="${sessionScope.user.role eq 'ADMIN'}"><th>Student</th></c:if><th>Submitted work</th><th>Status</th><th>Remarks / feedback</th><th>Submitted on</th><c:if test="${sessionScope.user.role eq 'ADMIN'}"><th>Review</th></c:if></tr></thead><tbody><c:forEach items="${submissions}" var="sub"><tr><td><strong><c:out value="${sub.lab_title}"/></strong><small class="cell-sub">Submission #<c:out value="${sub.id}"/></small></td><c:if test="${sessionScope.user.role eq 'ADMIN'}"><td><c:out value="${sub.student_name}"/><small class="cell-sub"><c:out value="${sub.student_email}"/></small></td></c:if><td><a class="external-link" href="<c:out value='${sub.submission_url}'/>" target="_blank" rel="noopener noreferrer">Open submission ↗</a></td><td><span class="status"><c:out value="${sub.status}"/></span></td><td><span><c:out value="${sub.remarks}"/></span><c:if test="${not empty sub.reviewer_feedback}"><small class="cell-sub">Feedback: <c:out value="${sub.reviewer_feedback}"/></small></c:if></td><td><c:out value="${sub.submitted_at}"/></td><c:if test="${sessionScope.user.role eq 'ADMIN'}"><td><form method="post" action="${pageContext.request.contextPath}/app/submissions" class="review-form"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="reviewSubmission"><input type="hidden" name="id" value="${sub.id}"><select name="status"><option value="PENDING" ${sub.status eq 'PENDING' ? 'selected' : ''}>PENDING</option><option value="REVIEWED" ${sub.status eq 'REVIEWED' ? 'selected' : ''}>REVIEWED</option><option value="ACCEPTED" ${sub.status eq 'ACCEPTED' ? 'selected' : ''}>ACCEPTED</option><option value="REJECTED" ${sub.status eq 'REJECTED' ? 'selected' : ''}>REJECTED</option></select><input name="feedback" maxlength="1000" placeholder="Feedback (optional)"><button class="button button-primary button-small" type="submit">Save review</button></form></td></c:if></tr></c:forEach><c:if test="${empty submissions}"><tr><td colspan="7" class="empty-state">No submissions yet. Students can submit work from the Labs page.</td></tr></c:if></tbody></table></div></section>
<%@ include file="footer.jspf" %>
