<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><c:out value="${pageTitle}"/> | CampusLab</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head><body>
<header class="topbar"><a class="brand" href="${pageContext.request.contextPath}/app/dashboard"><span class="brand-mark small">CL</span><span>CampusLab<small>Lab & Project Workspace</small></span></a><nav class="main-nav"><a href="${pageContext.request.contextPath}/app/dashboard">Overview</a><a href="${pageContext.request.contextPath}/app/courses">Courses</a><a href="${pageContext.request.contextPath}/app/labs">Labs</a><a href="${pageContext.request.contextPath}/app/projects">Projects</a><a href="${pageContext.request.contextPath}/app/submissions">Submissions</a><c:if test="${sessionScope.user.role eq 'ADMIN'}"><a href="${pageContext.request.contextPath}/app/users">Users</a></c:if></nav><div class="account"><span><strong><c:out value="${sessionScope.user.name}"/></strong><small><c:out value="${sessionScope.user.role}"/></small></span><a class="button button-quiet button-small" href="${pageContext.request.contextPath}/logout">Sign out</a></div></header><main class="page-shell">
<c:if test="${not empty flash}"><div class="alert alert-success"><c:out value="${flash}"/></div></c:if>
