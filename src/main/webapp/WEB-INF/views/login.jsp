<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in | CampusLab</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/style.css"></head>
<body class="login-page"><main class="login-shell"><section class="brand-panel"><div class="brand-mark">CL</div><p class="eyebrow">COLLEGE LAB & PROJECT MANAGEMENT</p><h1>CampusLab</h1><p class="muted">One workspace for practicals, projects, and student submissions.</p><div class="brand-points"><span>✓ Course and lab tracking</span><span>✓ Project progress</span><span>✓ Submission review</span></div></section><section class="login-panel"><h2>Welcome back</h2><p class="muted">Sign in to continue to your workspace.</p>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/login" class="form-stack"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><label>Email address<input type="email" name="email" autocomplete="username" required placeholder="you@college.edu"></label><label>Password<input type="password" name="password" autocomplete="current-password" required placeholder="Enter your password"></label><button class="button button-primary button-wide" type="submit">Sign in <span aria-hidden="true">→</span></button></form>
<div class="demo-credentials"><strong>Demo administrator</strong><span>admin@campuslab.local</span><span>Admin@123</span><hr><strong>Demo student</strong><span>student@campuslab.local</span><span>Student@123</span></div>
</section></main><footer class="login-footer">CampusLab · Advanced Java Lab Project</footer></body></html>
