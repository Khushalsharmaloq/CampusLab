<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ include file="header.jspf" %>
<section class="page-heading"><div><p class="eyebrow">ACADEMIC STRUCTURE</p><h1>Courses</h1><p class="muted">Course catalogue for lab and project work.</p></div></section>
<c:if test="${sessionScope.user.role eq 'ADMIN'}"><section class="panel form-panel"><div class="panel-heading"><div><p class="eyebrow">ADMINISTRATION</p><h2>Add a course</h2></div></div><form method="post" action="${pageContext.request.contextPath}/app/courses" class="inline-form"><input type="hidden" name="csrf" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="createCourse"><label>Course code<input name="code" required maxlength="24" placeholder="CS303"></label><label>Course name<input name="name" required maxlength="160" placeholder="Advanced Database Lab"></label><label>Semester<input type="number" name="semester" min="1" max="12" required value="6"></label><button class="button button-primary" type="submit">Add course</button></form></section></c:if>
<section class="panel table-panel"><div class="panel-heading"><div><p class="eyebrow">COURSE CATALOGUE</p><h2>Available courses</h2></div><span class="count-pill"><c:out value="${courses.size()}"/> courses</span></div><div class="table-wrap"><table><thead><tr><th>Code</th><th>Course name</th><th>Semester</th><th>Lab exercises</th><th>Created</th></tr></thead><tbody><c:forEach items="${courses}" var="course"><tr><td><span class="code-tag"><c:out value="${course.code}"/></span></td><td><strong><c:out value="${course.name}"/></strong></td><td><c:out value="${course.semester}"/></td><td><c:out value="${course.lab_count}"/></td><td><c:out value="${course.created_at}"/></td></tr></c:forEach><c:if test="${empty courses}"><tr><td colspan="5" class="empty-state">No courses have been created yet.</td></tr></c:if></tbody></table></div></section>
<%@ include file="footer.jspf" %>
