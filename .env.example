# Copy to .env using .\scripts\setup.ps1. Never commit .env.
# Local MySQL example; use a TLS-enabled URL for remote/production databases.
DB_URL=jdbc:mysql://localhost:3306/campuslab?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USER=campuslab_app
DB_PASSWORD=replace_with_a_strong_database_password

# Optional one-time administrator bootstrap. Uncomment and replace BOTH values
# before first startup. Use a unique password of at least 12 characters.
# BOOTSTRAP_ADMIN_NAME=CampusLab Administrator
# BOOTSTRAP_ADMIN_EMAIL=admin@your-college.edu
# BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_chars
